# ── Claude API ────────────────────────────────────────────────────
# Required for AI-powered research phases. Without it, the system
# produces deterministic fallback reports with [UNVERIFIED] markers.
ANTHROPIC_API_KEY=
RESEARCH_USE_LLM=true
RESEARCH_ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Optional: Phase 1 gap analysis — many tools + JSON (default max(3×RESEARCH_LLM_MAX_TOOL_ROUNDS, 35))
# RESEARCH_PHASE1_MAX_TURNS=45
# Optional: raise if Phase 2 stops mid-research (default max(3×RESEARCH_LLM_MAX_TOOL_ROUNDS, 40))
# RESEARCH_PHASE2_MAX_TURNS=50

# ── Embeddings (OpenAI-compatible API: OpenRouter, OpenAI, Azure, etc.) ─
# Important for quality: a real embedding service gives much better semantic search
#   during ingest and in search_corpus than the offline fallback.
# If you leave keys empty: local hash embeddings still run (no network bill), but
#   ranked results are often weaker—not wrong for demos, not ideal for production search.
# Provide ONE of: RESEARCH_EMBEDDING_API_KEY, OPENROUTER_API_KEY, or OPENAI_API_KEY.
OPENROUTER_API_KEY=
# RESEARCH_EMBEDDING_API_KEY=
RESEARCH_EMBEDDING_PROVIDER=openai_compatible
RESEARCH_EMBEDDING_MODEL=openai/text-embedding-3-small
RESEARCH_EMBEDDING_DIMENSIONS=1536
RESEARCH_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1

# ── Data Sources (SEC EDGAR requires a user agent) ────────────────
RESEARCH_USER_AGENT_NAME=investment-research/0.1
RESEARCH_USER_AGENT_EMAIL=your.email@company.com
